[Unit]
Description=Alex12060 Telegram Bot
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/alex12060-bot
EnvironmentFile=/opt/alex12060-bot/.env
ExecStart=/opt/alex12060-bot/venv/bin/python /opt/alex12060-bot/bot.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/alex12060-bot/logs/bot.log
StandardError=append:/opt/alex12060-bot/logs/bot.log
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
