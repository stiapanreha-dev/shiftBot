[Unit]
Description=Alex12060 Sync Worker - PostgreSQL to Google Sheets
After=network.target postgresql.service alex12060-bot.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/alex12060-bot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/alex12060-bot/.env
ExecStart=/opt/alex12060-bot/venv/bin/python /opt/alex12060-bot/pg_sync_worker.py --interval 300
Restart=always
RestartSec=30
MemoryMax=256M
StandardOutput=append:/opt/alex12060-bot/logs/sync_worker.log
StandardError=append:/opt/alex12060-bot/logs/sync_worker.log
NoNewPrivileges=true
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
